[user]
	name = Shivraj
	email = shivrajsoni09022005@gmail.com
	signingkey = FB6F60EAB9E58AF7

[init]
	defaultBranch = main

[core]
	pager = delta
	whitespace = error
	preloadindex = true

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = current

[rebase]
	autoStash = true

[fetch]
	prune = true          # delete local refs whose remote branch is gone
	pruneTags = true

[rerere]
	enabled = true        # remember conflict resolutions and replay them

[column]
	ui = auto             # multi-column branch/status listings when it fits

[branch]
	sort = -committerdate # `git branch` lists most-recently-used first

[tag]
	sort = version:refname

[diff]
	renames = copies
	interHunkContext = 10
	colorMoved = default

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true

[merge]
	conflictStyle = zdiff3

[status]
	showUntrackedFiles = all
	showStash = true
	branch = true

[alias]
	uncommit = reset --soft HEAD~1
	unstage = restore --staged .
	last = log -1 HEAD --stat
	graph = log --graph --oneline --all --decorate
