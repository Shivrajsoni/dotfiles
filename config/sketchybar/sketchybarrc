#!/usr/bin/env bash

export SKETCHYBAR_CONFIG_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SKETCHYBAR_CONFIG_DIR/variables.sh"

sketchybar --bar height=$BAR_HEIGHT \
  color=$TRANSPARENT \
  y_offset=$BAR_Y_OFFSET \
  margin=$BAR_MARGIN \
  padding_left=0 \
  padding_right=0 \
  sticky=on \
  position=top \
  topmost=window \
  --default updates=when_shown \
  icon.font="$FONT:Bold:14.0" \
  icon.color=$WHITE \
  icon.padding_left=10 \
  icon.padding_right=4 \
  label.font="$FONT:Bold:12.0" \
  label.color=$SUBTEXT \
  label.padding_left=4 \
  label.padding_right=10 \
  background.height=$ITEM_HEIGHT \
  background.corner_radius=$ITEM_CORNER_RADIUS \
  background.color=$SURFACE0 \
  background.border_color=$SURFACE1 \
  background.border_width=$BORDER_WIDTH \
  background.padding_left=$PADDINGS \
  background.padding_right=$PADDINGS

sketchybar --add event aerospace_workspace_change

# Left: workspaces, front app
source "$ITEM_DIR/spaces.sh"
source "$ITEM_DIR/front_app.sh"

# Right (added right-to-left): clock is outermost
source "$ITEM_DIR/clock.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/volume.sh"
source "$ITEM_DIR/cpu.sh"

sketchybar --hotload true --update
echo "sketchybar configuration loaded.."
